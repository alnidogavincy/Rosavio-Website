{
  "name": "rosavia-story",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/next-cli.cjs dev",
    "build": "node scripts/next-cli.cjs build",
    "start": "node scripts/next-cli.cjs start",
    "lint": "eslint app components config hooks",
    "typecheck": "tsc --noEmit",
    "test:browser": "node scripts/atelier-qa.cjs",
    "build:styles": "node node_modules/tailwindcss-reference/lib/cli.js -c tailwind.reference.cjs -i styles/atelier-tailwind.css -o app/atelier-utilities.css --minify",
    "predev": "npm run build:styles",
    "prebuild": "npm run build:styles"
  },
  "dependencies": {
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/dm-sans": "^5.2.8",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/italiana": "^5.2.7",
    "@fontsource/playfair-display": "^5.3.0",
    "gsap": "^3.14.2",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4.1.0",
    "tailwindcss-reference": "npm:tailwindcss@^3.4.17",
    "typescript": "^5.9.3"
  }
